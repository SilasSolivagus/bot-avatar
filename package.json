{
  "name": "bot-avatar",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "pretest": "pnpm build",
    "test": "vitest run",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "build": "pnpm --filter @botavatar/engine build && pnpm --filter @botavatar/pack-organic-blob build && pnpm --filter @botavatar/svg build && pnpm --filter @botavatar/service build",
    "bench": "node bench/service-bench.mjs",
    "gallery": "pnpm --filter @botavatar/gallery dev",
    "parity": "vitest run --config vitest.parity.config.ts"
  },
  "devDependencies": {
    "@botavatar/engine": "workspace:*",
    "@botavatar/pack-organic-blob": "workspace:*",
    "@botavatar/svg": "workspace:*",
    "@types/node": "^22.20.5",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
